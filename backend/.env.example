APP_NAME="Lemony"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of the Laravel app (API). In production: https://yourdomain.mn
APP_URL=http://localhost:8000
# Where the Vite frontend is served (used for CORS). Comma-separate multiple origins.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=mn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soulmate_check
DB_USERNAME=soulmate
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" generates the report inside the HTTP request (simplest for local dev).
# In production use "database" and run a queue worker (see README).
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log

# --- AI provider for the report: "openai" or "gemini" ---------------------------
AI_PROVIDER=openai

# --- Google Gemini (server-side only) -------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (server-side only — never put this in the frontend) -------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT=120
OPENAI_MAX_OUTPUT_TOKENS=12000
REPORT_LANGUAGE="Mongolian (Cyrillic script)"

# --- QPay merchant API v2 ------------------------------------------------------
# Production: https://merchant.qpay.mn/v2   Sandbox: https://merchant-sandbox.qpay.mn/v2
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Public HTTPS URL QPay calls after payment; the payment reference is appended.
QPAY_CALLBACK_URL=https://yourdomain.mn/api/payments/qpay/callback
QPAY_INVOICE_RECEIVER_CODE=terminal

# --- Pricing ----------------------------------------------------------------------
REPORT_PRICE=7900
REPORT_CURRENCY=MNT

# Development only: allows marking a test assessment as paid without QPay.
# Ignored when APP_ENV=production.
PAYMENT_BYPASS=false

# Days before abandoned, unpaid assessments are deleted.
UNPAID_RETENTION_DAYS=30

# Analytics dashboard at /admin — set a long random key to enable it (e.g. `php -r "echo bin2hex(random_bytes(24));"`).
ANALYTICS_DASHBOARD_KEY=
ANALYTICS_TIMEZONE=Asia/Ulaanbaatar
