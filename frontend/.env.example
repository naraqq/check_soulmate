# Leave empty when the API is served from the same origin (/api) — the default
# for both local development (Vite proxy) and production (Nginx).
VITE_API_BASE_URL=

# Local dev only: where Vite proxies /api (Laravel `php artisan serve`).
DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Display fallback only; the real price always comes from the backend (REPORT_PRICE).
VITE_REPORT_PRICE=7900
VITE_REPORT_CURRENCY=MNT

# Never put API keys or QPay credentials here — everything in VITE_* is public.
