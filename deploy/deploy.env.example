# Copy to deploy/deploy.env (git-ignored) and fill in.

# SSH login for the server (AWS Ubuntu images use the "ubuntu" user).
SERVER=ubuntu@1.2.3.4

# Path to the .pem key you downloaded from AWS. Leave empty to use your default SSH key.
SSH_KEY=~/Downloads/soulmate.pem

# Your domain, e.g. soulmatecheck.mn. Leave empty to serve over http://<server-ip> for now.
DOMAIN=

# Email for Let's Encrypt certificate notices (needed for `./deploy.sh ssl`).
EMAIL=
